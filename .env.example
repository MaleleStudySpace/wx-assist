# === AI Provider ===
# API 根地址 (不要以斜杠结尾)
# OpenAI 格式: 裸域名自动补 /v1，有路径(如 /v2 /api)原样使用
#   示例: https://api.deepseek.com
#         https://maas-api.cn-huabei-1.xf-yun.com/v2
# Anthropic 格式: 原样传给 SDK，SDK 自拼 /v1/messages
#   示例: https://api.anthropic.com
#         https://token-plan-sgp.xiaomimimo.com/anthropic
AI_PROVIDER_BASE_URL=

# API Key / Token
AI_PROVIDER_API_KEY=

# API 格式: "openai" | "anthropic" | "custom" | "auto"
# openai    — OpenAI Chat Completions 兼容 (默认, 适用于 DeepSeek/OpenAI/MiMo/中转等)
# anthropic — Anthropic Messages 兼容 (适用于 Claude 代理)
# custom    — 自定义端点, URL 原样使用不拼接路径
# auto      — 自动探测 (兼容旧配置)
AI_PROVIDER_TYPE=openai

# Agent 对话（带工具）单次 LLM 请求超时（秒）。工具较多或中转较慢时可调大；默认 120
AI_AGENT_TIMEOUT_SEC=120

# 普通对话等 LLM 请求的客户端级默认超时（秒），默认 60。
# Anthropic 后端不填则沿用 SDK 默认（600）。
AI_REQUEST_TIMEOUT_SEC=60

# 公众号即时提醒摘要的外层等待（秒），默认 90，需大于上面的客户端超时，
# 否则模型慢一点就会把已经生成的摘要丢掉。
OA_ALERT_SUMMARY_TIMEOUT_SEC=90

# 模型 ID (如 DeepSeek-V4-Flash, deepseek-chat, gpt-4o, claude-sonnet-4-6)
AI_PROVIDER_MODEL=

# 附加参数 (JSON 字符串, 可选)
# 发送给 API 的 extra_body, 可覆盖默认的 temperature、max_tokens 等
# 示例: {"thinking":{"type":"disabled"}}  ← DeepSeek 专用
#       {"temperature":0.7,"max_tokens":8192}
AI_PROVIDER_EXTRA_BODY=

# === 语音通话助手（Voice Companion）===
# 语音助手总开关：false 时网页不显示麦克风入口（默认 true）
VOICE_ENABLED=true

# ── A 档：标准模式（STT + 你的 LLM + TTS 拼装，免费通道可零成本，B 档降级用）──
VOICE_STANDARD_ENABLED=true
# STT：browser（浏览器内置识别，免费，推荐 Edge）| openai（云端 /audio/transcriptions）
VOICE_STT_PROVIDER=browser
# 云端识别可填任何 OpenAI 兼容服务，如硅基流动 SenseVoiceSmall：https://api.siliconflow.cn/v1
VOICE_STT_BASE_URL=
VOICE_STT_API_KEY=
VOICE_STT_MODEL=whisper-1

# TTS：edge（默认免费）| qwen（千问实时流式 ¥1/万字，复用 VOICE_REALTIME_API_KEY）
#      | openai（OpenAI 兼容 /audio/speech）
VOICE_TTS_PROVIDER=edge
VOICE_TTS_BASE_URL=
VOICE_TTS_API_KEY=
VOICE_TTS_MODEL=tts-1
# Edge 音色：zh-CN-XiaoxiaoNeural(晓晓·女,默认) / zh-CN-YunxiNeural(云希·男)
#           zh-CN-XiaoyiNeural(晓伊) / zh-CN-YunyangNeural(云扬) 等
VOICE_TTS_VOICE=zh-CN-XiaoxiaoNeural
# 语速：仅 A 档 edge-tts 生效（形如 +15% / -10% / +0% 不变速）；B 档端到端语速由模型决定，不可调
VOICE_TTS_RATE=+0%
# 千问流式 TTS 音色
VOICE_TTS_QWEN_MODEL=qwen3-tts-flash-realtime
VOICE_TTS_QWEN_VOICE=Cherry

# ── B 档：端到端全双工实时语音（豆包同款通话感）──
# 与 A 档都开启时优先 B，B 连不上自动降级 A。
# 服务商：qwen（千问，默认）| volc（火山豆包 Seeduplex 3.0）
VOICE_RT_PROVIDER=qwen
# ── 千问：Key 在 https://platform.qianwenai.com 创建 ──
VOICE_REALTIME_ENABLED=false
VOICE_REALTIME_API_KEY=
# 全模态（便宜，推荐）：qwen3.8-omni-flash-realtime / qwen3.5-omni-flash-realtime
# 纯语音旗舰：qwen-audio-3.1-realtime-plus；最省：qwen-audio-3.0-realtime-flash
VOICE_REALTIME_MODEL=qwen3.8-omni-flash-realtime
# 音色随模型家族：omni 用 Tina/Cici/Evan 等；qwen-audio 用 longanqian_v3.1 等
VOICE_REALTIME_VOICE=Tina
# smart_turn（语义断句，嗯/啊附和不会误打断，推荐）| server_vad（停顿断句）
VOICE_REALTIME_TURN_MODE=smart_turn
# ── 火山豆包 Seeduplex 3.0（model 固定 1.2.6.1，X-Api-Key 鉴权，主打车载抗干扰）──
# 控制台：https://console.volcengine.com/speech  开通"端到端实时语音大模型"
VOICE_VOLC_ENABLED=false
VOICE_VOLC_API_KEY=
# 主打音色：Vivi2.0(zh_female_vv_uranus_bigtts)/小何2.0/云舟2.0(zh_male_m191_uranus_bigtts)/小天2.0
VOICE_VOLC_VOICE=zh_female_vv_uranus_bigtts

# === WeChat ===
# 微信数据目录 — wxid_* 文件夹的父目录。留空自动检测。
WECHAT_DATA_DIR=

# 微信账号标识 (如 wxid_xxxxxxxxxxxxxx)，自动检测。需要覆盖时设置此项。
WXID=

# 数据库文件路径 (如 D:\vxchat\xwechat_files\wxid_xxx\db_storage\session\session.db)
# 仅当自动检测失败时需要手动指定。
DB_PATH=

# 后端类型: "wcdb" (Windows) 或 "mac_hybrid" / "mac_ui" (macOS)
WECHAT_BACKEND=wcdb

# 逗号分隔的群名列表。"*" = 自动发现所有群
WECHAT_GROUPS=*

# === Onboarding ===
# 是否完成首次引导 (true/false)
ONBOARDING_DONE=

# === 通用 / 窗口行为 ===
# 点击窗口关闭按钮时的行为 (改完立即生效，不用重启)
#   ask  — 每次弹窗询问（默认）
#   tray — 最小化到托盘，程序继续在后台运行
#   quit — 直接退出程序
CLOSE_ACTION=ask

# === 更新 ===
# 启动时自动检查是否有新版本 (true/false)。只提示，不会自动下载。
AUTO_CHECK_UPDATE=true

# 忽略的版本号。填 1.6.1 后不再提示该版本，直到出现更新的版本。
SKIP_VERSION=
